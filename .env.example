# Copy to .env and adjust as needed. All variables are optional; sensible
# local-first defaults are baked into backend/app/core/config.py.

# --- Server binding (never expose beyond localhost without deliberately reviewing this) ---
TASKPILOT_HOST=127.0.0.1
TASKPILOT_PORT=8000

# --- Local model (Ollama) ---
TASKPILOT_LLM_PROVIDER=ollama
TASKPILOT_OLLAMA_BASE_URL=http://localhost:11434
TASKPILOT_OLLAMA_MODEL=qwen3:4b

# --- Agent execution limits ---
TASKPILOT_MAX_TASKS_PER_RUN=25
TASKPILOT_MAX_RETRIES_PER_TASK=3
TASKPILOT_MAX_REPLANNING_ATTEMPTS=3
TASKPILOT_MAX_RUN_DURATION_SECONDS=1800
TASKPILOT_MAX_TOOL_CALLS_PER_RUN=100

# --- Approvals ---
TASKPILOT_APPROVAL_TTL_SECONDS=900

# --- Browser automation ---
TASKPILOT_BROWSER_HEADLESS=false
# Comma-separated list; empty means the agent may propose any domain, subject to
# per-navigation approval. Populate this to restrict the agent to specific sites.
TASKPILOT_BROWSER_ALLOWED_DOMAINS_RAW=

# --- Python execution runner ---
TASKPILOT_PYTHON_RUNNER_BASE_URL=http://localhost:8100
TASKPILOT_PYTHON_RUNNER_TIMEOUT_SECONDS=60
TASKPILOT_PYTHON_RUNNER_MEMORY_LIMIT_MB=512
TASKPILOT_PYTHON_RUNNER_CPU_LIMIT=1.0
